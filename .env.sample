# ==============================================================================
# Filename: .env.sample
# Purpose: Environment variable overrides file for IBM MQ connection parameters.
#
# Instructions:
# 1. Copy this file to a new file named '.env' in the same directory:
#    cp .env.sample .env
# 2. Update the values in '.env' with your actual MQ environment credentials.
# 3. Do NOT commit the resulting '.env' file to your version control repository.
# ==============================================================================

# Application environment configuration overrides
APP_ENV=Production

# MQ Server endpoints
MQ_HOST=mq-server.example.com
MQ_PORT=1414
MQ_CHANNEL=APP.SVRCONN
MQ_QUEUE_MANAGER=QM_PROD
MQ_TEST_QUEUE=HEALTH.CHECK.TEST

# Sensitive Credentials
MQ_USERNAME=mq_app_user # SENSITIVE
MQ_PASSWORD=super_secret_password_here # SENSITIVE

# TLS Connection parameters (Optional - uncomment if using secure connections)
# MQ_SSL_CIPHER_SUITE=TLS_RSA_WITH_AES_128_CBC_SHA256 # SENSITIVE
# MQ_KEYSTORE_PATH=/path/to/keystore.jks # SENSITIVE
# MQ_KEYSTORE_PASSWORD=keystore_password_here # SENSITIVE
