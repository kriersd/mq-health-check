# ==============================================================================
# Filename: .env.sample
# Purpose: Environment variable overrides file for IBM MQ Connection and Health Checking.
#
# Instructions:
# 1. Copy this file to a new file named '.env' in the same directory:
#    cp .env.sample .env
# 2. Update the values in '.env' with your actual MQ environment credentials.
# 3. Do NOT commit the resulting '.env' file to your version control repository.
# ==============================================================================

# Application environment configuration overrides
APP_ENV=Production
PORT=8080

# MQ Server endpoints
MQ_HOST=mq-server.example.com
MQ_PORT=1414
MQ_CHANNEL=APP.SVRCONN
MQ_QUEUE_MANAGER=QM_PROD
MQ_TEST_QUEUE=HEALTH.CHECK.TEST
MQ_DLQ_NAME=SYSTEM.DEAD.LETTER.QUEUE

# Direct File System and Keystore Paths (Used for out-of-REST direct verification checks)
MQ_INI_PATH=/var/mqm/qmgrs/QM_PROD/qm.ini
MQ_DATA_PATH=/var/mqm
MQ_KEYSTORE_PATH=/var/mqm/ssl/key.jks # SENSITIVE
MQ_KEYSTORE_PASSWORD=super_secret_keystore_password # SENSITIVE

# Sensitive Connection Credentials
MQ_USERNAME=mq_app_user # SENSITIVE
MQ_PASSWORD=super_secret_password_here # SENSITIVE

# TLS Connection parameters (Optional - uncomment if using secure connections)
MQ_SSL_CIPHER_SUITE=TLS_RSA_WITH_AES_128_CBC_SHA256 # SENSITIVE

# ------------------------------------------------------------------------------
# 12 Health Checks Enable/Disable Switches
# Set to 'true' to enable, or 'false' to bypass the check entirely.
# ------------------------------------------------------------------------------
CHECK_LISTENER_ENABLED=true
CHECK_QMGR_CONNECT_ENABLED=true
CHECK_CLIENT_CONNECT_ENABLED=true
CHECK_MAX_CHANNELS_ENABLED=true
CHECK_DISK_SPACE_ENABLED=true
CHECK_CERT_EXPIRY_ENABLED=true
CHECK_TEST_QUEUE_ENABLED=true
CHECK_DLQ_DEPTH_ENABLED=true
CHECK_APP_QUEUE_DEPTH_ENABLED=true
CHECK_LDAP_ENABLED=true
CHECK_CHANNEL_STATUS_ENABLED=true
CHECK_HOST_RESOURCES_ENABLED=true
